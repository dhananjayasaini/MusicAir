<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <!-- Folder Image -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardImage"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/albumImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_music_folder"
                android:background="@color/bright_yellow"/>

            <TextView
                android:id="@+id/albumCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 song"
                android:textSize="16sp"
                android:textColor="@android:color/white"
                android:layout_gravity="bottom|start"
                android:padding="4dp"/>

        </FrameLayout>

    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/albumName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Item Name"
        android:textStyle="bold"
        android:textSize="12sp"
        android:textColor="#1D1D1D"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/cardImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/itemMenu"/>

    <ImageView
        android:id="@+id/itemMenu"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_dots"
        app:layout_constraintTop_toTopOf="@id/albumName"
        app:layout_constraintBottom_toBottomOf="@id/itemSubName"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="#808080" />

    <TextView
        android:id="@+id/itemSubName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Unknown"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="12sp"
        android:textColor="#888888"
        app:layout_constraintTop_toBottomOf="@id/albumName"
        app:layout_constraintStart_toStartOf="@id/albumName"
        app:layout_constraintEnd_toEndOf="@id/albumName"/>

</androidx.constraintlayout.widget.ConstraintLayout>

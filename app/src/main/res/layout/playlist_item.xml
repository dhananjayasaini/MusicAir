<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Playlist Icon -->
    <ImageView
        android:id="@+id/playlistIcon"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:src="@drawable/playlist_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <!-- Name -->
    <TextView
        android:id="@+id/playlistName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="My Playlist"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginTop="12dp"
        android:textColor="@android:color/black"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@id/playlistIcon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/playlistMenuIcon"/>

    <!-- Song Count -->
<!--    <TextView-->
<!--        android:id="@+id/playlistSongCount"-->
<!--        android:layout_width="0dp"-->
<!--        android:layout_height="wrap_content"-->
<!--        android:text="0 Song"-->
<!--        android:textSize="14sp"-->
<!--        android:textColor="@android:color/darker_gray"-->
<!--        android:layout_marginStart="12dp"-->
<!--        android:layout_marginTop="4dp"-->
<!--        android:paddingBottom="4dp"-->
<!--        app:layout_constraintStart_toEndOf="@id/playlistIcon"-->
<!--        app:layout_constraintTop_toBottomOf="@id/playlistName"-->
<!--        app:layout_constraintEnd_toStartOf="@id/playlistMenuIcon"/>-->

    <!-- Dots -->
    <ImageView
        android:id="@+id/playlistMenuIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_dots"
        app:tint="@android:color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>

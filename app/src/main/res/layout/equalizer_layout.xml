            <!-- Reverb Layout -->
            <LinearLayout
                android:id="@+id/reverbLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintTop_toBottomOf="@id/bandContainer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Reverb"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <Spinner
                    android:id="@+id/spinnerReverb"
                    android:layout_width="140dp"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/gray"
                    android:background="@drawable/bg_chip_unselected"
                    android:padding="6dp"/>
            </LinearLayout>

            <!-- Bass Boost -->
            <LinearLayout
                android:id="@+id/bassBoostLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintTop_toBottomOf="@id/reverbLayout"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:text="Bass Boost"
                    android:textColor="@color/white"
                    android:textSize="14sp"/>

                <SeekBar
                    android:id="@+id/seekBass"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:progress="600"
                    android:max="1000"
                    android:thumbTint="#FF9F00"
                    android:progressTint="#FF9F00"/>
            </LinearLayout>

            <!-- Virtualizer -->
            <LinearLayout
                android:id="@+id/virtualizerLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="30dp"
                app:layout_constraintTop_toBottomOf="@id/bassBoostLayout"

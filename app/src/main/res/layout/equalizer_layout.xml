            <!-- Equalizer Bars -->
            <!-- Equalizer Bars -->
            <LinearLayout
                android:id="@+id/bandContainer"
                android:layout_width="0dp"
                android:layout_height="380dp"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:weightSum="5"
                app:layout_constraintTop_toBottomOf="@id/spinnerPreset"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Band 60Hz -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/tvBand60"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.0"
                        android:textColor="#777777"
                        android:textSize="12sp"
                        android:layout_marginBottom="6dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <com.dhananjaysaini.musicplayerapp.utils.EQVerticalBar
                        android:id="@+id/seekBand60"
                        android:layout_width="35dp"
                        android:layout_height="0dp"
                        android:max="100"
                        android:progress="50"
                        android:progressDrawable="@drawable/eq_progress"
                        android:thumb="@drawable/eq_thumb"
                        android:splitTrack="false"
                        app:layout_constraintTop_toBottomOf="@id/tvBand60"
                        app:layout_constraintBottom_toTopOf="@id/tvHz60"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <TextView
                        android:id="@+id/tvHz60"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="60 Hz"
                        android:textColor="#777777"
                        android:textSize="12sp"
                        android:layout_marginTop="6dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

